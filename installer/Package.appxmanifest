<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/uap"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Atoll.DynamicIsland"
    Publisher="CN=Atoll"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Atoll Dynamic Island</DisplayName>
    <PublisherDisplayName>Atoll</PublisherDisplayName>
    <Description>Native Windows 10/11 Dynamic Island overlay with spring physics.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="AtollApp" Executable="Atoll.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Atoll Dynamic Island"
        Description="Native Windows 10/11 Dynamic Island"
        BackgroundColor="#000000"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap:Capability Name="userNotificationListener" />
    <uap:Capability Name="appointments" />
  </Capabilities>
</Package>

