<Window x:Class="Atoll.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Atoll.Views.Controls"
        Title="Atoll Dynamic Island"
        Width="580"
        Height="310"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        AllowDrop="True">

    <Canvas x:Name="RootCanvas"
            Width="580"
            Height="310"
            Background="Transparent">

        <!-- Ambient Dominant Color Glow (disabled in Low Power Mode) -->
        <Ellipse x:Name="AmbientGlow"
                 IsHitTestVisible="False"
                 Width="260"
                 Height="90"
                 Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="GlowStopInner" Color="#550A84FF" Offset="0.0" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Zero-shader layered shadow for Main Pill -->
        <Path x:Name="PillShadowOuter"
              IsHitTestVisible="False"
              Fill="#1E000000" />
        <Path x:Name="PillShadowInner"
              IsHitTestVisible="False"
              Fill="#3A000000" />

        <!-- Main Pill Shell -->
        <Path x:Name="MainPillPath"
              Fill="#000000"
              Stroke="#28FFFFFF"
              StrokeThickness="1" />

        <!-- Detached Minimal Bubble Shadow & Shell -->
        <Path x:Name="BubbleShadow"
              IsHitTestVisible="False"
              Fill="#2E000000"
              Visibility="Collapsed" />
        <Path x:Name="DetachedBubblePath"
              Fill="#000000"
              Stroke="#28FFFFFF"
              StrokeThickness="1"
              Visibility="Collapsed" />

        <!-- Detached Minimal Bubble Content -->
        <Grid x:Name="BubbleContentHost"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BubbleScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <controls:RingProgressControl x:Name="BubbleRing"
                                          Width="28"
                                          Height="28"
                                          StrokeThickness="2.2"
                                          Visibility="Collapsed" />
            <Border x:Name="BubbleThumbBorder"
                    Width="20"
                    Height="20"
                    CornerRadius="10"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                <Image x:Name="BubbleThumbImage" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="BubbleGlyph"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="13"
                       Foreground="#F5F5F7"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Main Pill Content Host (BitmapCache + RenderTransform friendly) -->
        <Grid x:Name="MainContentHost"
              RenderTransformOrigin="0.5,0.5">
            <Grid.CacheMode>
                <BitmapCache EnableClearType="True" RenderAtScale="1" SnapsToDevicePixels="True" />
            </Grid.CacheMode>
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ContentScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- 1. IDLE STATE (subtle privacy indicator dots when sensors active) -->
            <Grid x:Name="IdlePanel" Visibility="Visible">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Ellipse x:Name="IdleCamDot" Width="6" Height="6" Fill="#30D158" Margin="3,0" Visibility="Collapsed" />
                    <Ellipse x:Name="IdleMicDot" Width="6" Height="6" Fill="#FF9F0A" Margin="3,0" Visibility="Collapsed" />
                    <Ellipse x:Name="IdleRecDot" Width="6" Height="6" Fill="#FF453A" Margin="3,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- 2. COMPACT / MINIMAL PRIMARY STATE -->
            <Grid x:Name="CompactPanel" Visibility="Collapsed" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Leading Art or Glyph -->
                <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
                    <Border x:Name="CompactThumbBorder" CornerRadius="6" ClipToBounds="True" Visibility="Collapsed">
                        <Image x:Name="CompactThumbImage" Stretch="UniformToFill" />
                    </Border>
                    <Border x:Name="CompactGlyphBg" Width="22" Height="22" CornerRadius="11" Background="#22FFFFFF">
                        <TextBlock x:Name="CompactGlyphText"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="#F5F5F7"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Center Short Label -->
                <TextBlock x:Name="CompactTitleText"
                           Grid.Column="1"
                           Foreground="#E5E5EA"
                           FontSize="11.5"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0" />

                <!-- Trailing Visualizer / Ring / Text / Privacy Dots -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:AudioVisualizerControl x:Name="CompactVisualizer"
                                                     Width="22"
                                                     Height="14"
                                                     Margin="0,0,2,0"
                                                     Visibility="Collapsed" />
                    <controls:RingProgressControl x:Name="CompactRing"
                                                  Width="18"
                                                  Height="18"
                                                  StrokeThickness="2.2"
                                                  Margin="0,0,5,0"
                                                  Visibility="Collapsed" />
                    <TextBlock x:Name="CompactTrailingLabel"
                               Foreground="#F5F5F7"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Ellipse x:Name="CompactCamDot" Width="5" Height="5" Fill="#30D158" Margin="4,0,0,0" Visibility="Collapsed" />
                    <Ellipse x:Name="CompactMicDot" Width="5" Height="5" Fill="#FF9F0A" Margin="3,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- 3. ALERT / PEEK STATE -->
            <Grid x:Name="AlertPanel" Visibility="Collapsed" Margin="14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                        <Border x:Name="AlertThumbBorder" CornerRadius="10" ClipToBounds="True" Visibility="Collapsed">
                            <Image x:Name="AlertThumbImage" Stretch="UniformToFill" />
                        </Border>
                        <Border x:Name="AlertIconBg" Width="40" Height="40" CornerRadius="20" Background="#220A84FF">
                            <TextBlock x:Name="AlertGlyphText"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="#F5F5F7"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,8,0">
                        <TextBlock x:Name="AlertTitleText"
                                   Foreground="#F5F5F7"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AlertSubtitleText"
                                   Foreground="#A1A1AA"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="30"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:RingProgressControl x:Name="AlertRing"
                                                      Width="30"
                                                      Height="30"
                                                      StrokeThickness="2.8"
                                                      Visibility="Collapsed" />
                        <TextBlock x:Name="AlertTrailingText"
                                   Foreground="#F5F5F7"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <Slider x:Name="AlertOsdSlider"
                        Grid.Row="1"
                        Minimum="0"
                        Maximum="100"
                        Foreground="{DynamicResource AccentPrimaryBrush}"
                        Style="{StaticResource IslandSliderStyle}"
                        Margin="0,6,0,0"
                        Visibility="Collapsed"
                        ValueChanged="OnAlertOsdSliderValueChanged" />
            </Grid>

            <!-- 4. EXPANDED STATE -->
            <Grid x:Name="ExpandedPanel" Visibility="Collapsed" Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header / Switcher Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevActivityBtn"
                                Content="&#xE76B;"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="10"
                                Padding="6,3"
                                Margin="0,0,4,0"
                                Style="{StaticResource IslandIconButtonStyle}"
                                Click="OnPrevActivityClick"
                                Visibility="Collapsed" />
                        <TextBlock x:Name="ExpandedHeaderLabel"
                                   Foreground="#98989F"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="ATOLL" />
                        <Button x:Name="NextActivityBtn"
                                Content="&#xE76C;"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="10"
                                Padding="6,3"
                                Margin="4,0,0,0"
                                Style="{StaticResource IslandIconButtonStyle}"
                                Click="OnNextActivityClick"
                                Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="QuickActionsTabBtn"
                                Content="&#xE71D;"
                                ToolTip="Quick Actions"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="11"
                                Padding="7,4"
                                Margin="0,0,4,0"
                                Style="{StaticResource IslandIconButtonStyle}"
                                Click="OnQuickActionsTabClick" />
                        <Button Content="&#xE713;"
                                ToolTip="Settings"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="11"
                                Padding="7,4"
                                Margin="0,0,4,0"
                                Style="{StaticResource IslandIconButtonStyle}"
                                Click="OnOpenSettingsClick" />
                        <Button Content="&#xE70E;"
                                ToolTip="Collapse"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="11"
                                Padding="7,4"
                                Style="{StaticResource IslandIconButtonStyle}"
                                Click="OnCollapseClick" />
                    </StackPanel>
                </Grid>

                <!-- Expanded Body Views -->
                <Grid Grid.Row="1">
                    <!-- MEDIA CARD -->
                    <Grid x:Name="MediaCard" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="10" Width="52" Height="52" Background="#202026" BorderBrush="#1AFFFFFF" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="&#xE8D6;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="20"
                                               Foreground="#68FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image x:Name="MediaArtImage" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                <TextBlock x:Name="MediaTitleText" Foreground="#F5F5F7" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaArtistText" Foreground="#98989F" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <controls:AudioVisualizerControl x:Name="MediaExpandedVisualizer"
                                                             Grid.Column="2"
                                                             Width="26"
                                                             Height="18"
                                                             VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MediaPosText" Foreground="#8E8E93" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider x:Name="MediaSeekSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    Foreground="#F5F5F7"
                                    Style="{StaticResource IslandSliderStyle}"
                                    PreviewMouseLeftButtonDown="OnMediaSeekStart"
                                    PreviewMouseLeftButtonUp="OnMediaSeekCommit" />
                            <TextBlock x:Name="MediaDurText" Grid.Column="2" Foreground="#8E8E93" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="14" Padding="14,6" Style="{StaticResource IslandIconButtonStyle}" Click="OnMediaPrevClick" />
                            <Button x:Name="MediaPlayPauseBtn" Content="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="16" Padding="18,6" Margin="10,0" Style="{StaticResource IslandIconButtonStyle}" Click="OnMediaPlayPauseClick" />
                            <Button Content="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="14" Padding="14,6" Style="{StaticResource IslandIconButtonStyle}" Click="OnMediaNextClick" />
                        </StackPanel>
                    </Grid>

                    <!-- TIMER CARD -->
                    <Grid x:Name="TimerCard" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:RingProgressControl x:Name="TimerExpandedRing" Width="44" Height="44" StrokeThickness="3.5" RingColor="#FF9F0A" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock x:Name="TimerExpandedLabel" Foreground="#98989F" FontSize="11.5" />
                                <TextBlock x:Name="TimerExpandedReadout" Foreground="#F5F5F7" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="TimerPlayPauseBtn" Content="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="14" Padding="12,8" Margin="0,0,6,0" Style="{StaticResource IslandIconButtonStyle}" Click="OnTimerPauseResumeClick" />
                                <Button Content="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="14" Padding="12,8" Style="{StaticResource IslandIconButtonStyle}" Click="OnTimerStopClick" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="+1m" Tag="1" Style="{StaticResource IslandChipButtonStyle}" Margin="3,0" Click="OnQuickTimerPresetClick" />
                            <Button Content="+5m" Tag="5" Style="{StaticResource IslandChipButtonStyle}" Margin="3,0" Click="OnQuickTimerPresetClick" />
                            <Button Content="+10m" Tag="10" Style="{StaticResource IslandChipButtonStyle}" Margin="3,0" Click="OnQuickTimerPresetClick" />
                            <Button Content="+25m" Tag="25" Style="{StaticResource IslandChipButtonStyle}" Margin="3,0" Click="OnQuickTimerPresetClick" />
                            <Button Content="Stopwatch" Style="{StaticResource IslandChipButtonStyle}" Margin="3,0" Click="OnStartStopwatchClick" />
                        </StackPanel>
                    </Grid>

                    <!-- CALL CARD -->
                    <Grid x:Name="CallCard" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" Background="#2830D158" VerticalAlignment="Center">
                            <TextBlock Text="&#xE717;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock x:Name="CallAppText" Foreground="#F5F5F7" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="CallDurationText" Foreground="#30D158" FontSize="12.5" FontWeight="Medium" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CallMuteBtn" Padding="12,8" Margin="0,0,8,0" Style="{StaticResource IslandIconButtonStyle}" Click="OnCallMuteClick">
                                <TextBlock x:Name="CallMuteLabel" Text="Mute" FontSize="12" />
                            </Button>
                            <Button Background="#CCFF453A" Padding="12,8" Style="{StaticResource IslandIconButtonStyle}" Click="OnCallFocusOrEndClick">
                                <TextBlock Text="Window" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- FILE SHELF CARD -->
                    <Grid x:Name="ShelfCard" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox x:Name="ShelfListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseMove="OnShelfItemMouseMove">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="#18FFFFFF" />
                                    <Setter Property="Foreground" Value="#F5F5F7" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Foreground="#98989F" FontSize="10.5" VerticalAlignment="Center" Margin="8,0" />
                                        <Button Grid.Column="2" Content="&#xE711;" Tag="{Binding FullPath}" FontFamily="{StaticResource IconFont}" FontSize="9" Padding="5,2" Style="{StaticResource IslandIconButtonStyle}" Click="OnRemoveShelfItemClick" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <TextBlock Text="Drag items out to move" Foreground="#8E8E93" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="Drag All" Style="{StaticResource IslandChipButtonStyle}" Margin="0,0,6,0" PreviewMouseLeftButtonDown="OnDragAllShelfItems" />
                            <Button Content="Clear" Style="{StaticResource IslandChipButtonStyle}" Click="OnClearShelfClick" />
                        </StackPanel>
                    </Grid>

                    <!-- GENERIC / CALENDAR / BATTERY / PRIVACY / NOTIFICATION EXPANDED CARD -->
                    <Grid x:Name="GenericActivityCard" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:RingProgressControl x:Name="GenericRing" Width="44" Height="44" StrokeThickness="3.2" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock x:Name="GenericTitle" Foreground="#F5F5F7" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="GenericSubtitle" Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap" MaxHeight="44" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="GenericDismissBtn" Grid.Column="2" Content="Dismiss" Style="{StaticResource IslandChipButtonStyle}" VerticalAlignment="Center" Click="OnDismissCurrentActivityClick" />
                    </Grid>

                    <!-- QUICK ACTIONS + IDLE GLANCE CARD -->
                    <Grid x:Name="QuickActionsCard" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Optional Clock & Weather Glance -->
                        <Grid x:Name="GlanceRow" Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GlanceTimeText" Foreground="#F5F5F7" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock x:Name="GlanceDateText" Foreground="#98989F" FontSize="11" />
                                <TextBlock x:Name="GlanceWeatherText" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="11.5" FontWeight="Medium" />
                            </StackPanel>
                        </Grid>

                        <!-- Quick Actions Row -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Style="{StaticResource IslandChipButtonStyle}" Margin="0,0,6,0" Click="OnScreenshotClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="Shot" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DndToggleBtn" Style="{StaticResource IslandChipButtonStyle}" Margin="0,0,6,0" Click="OnToggleDndClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock x:Name="DndToggleLabel" Text="Focus: Off" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="1" Style="{StaticResource IslandChipButtonStyle}" Margin="0,0,6,0" Click="OnQuickTimerPresetClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="1m" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Tag="5" Style="{StaticResource IslandChipButtonStyle}" Margin="0,0,6,0" Click="OnQuickTimerPresetClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="5m" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IslandChipButtonStyle}" Click="OnStartStopwatchClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE917;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Stopwatch" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Clipboard History (click to copy)" Foreground="#8E8E93" FontSize="10.5" Margin="0,0,0,4" />

                        <ItemsControl x:Name="ClipboardItemsList" Grid.Row="3">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding PreviewText}"
                                            Tag="{Binding}"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,2"
                                            Padding="8,4"
                                            Style="{StaticResource IslandChipButtonStyle}"
                                            Click="OnClipboardItemClick" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Canvas>
</Window>

