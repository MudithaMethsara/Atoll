<Window x:Class="Atoll.Views.DiagnosticsOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atoll Diagnostics"
        Width="248"
        Height="156"
        Left="14"
        Top="14"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Border Background="#CC0E0E10"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12">
        <StackPanel>
            <TextBlock Text="ATOLL DIAGNOSTICS" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock x:Name="StateText" Foreground="#F5F5F7" FontSize="11.5" />
            <TextBlock x:Name="FpsText" Foreground="#D1D1D6" FontSize="11.5" />
            <TextBlock x:Name="CpuText" Foreground="#D1D1D6" FontSize="11.5" />
            <TextBlock x:Name="RamText" Foreground="#D1D1D6" FontSize="11.5" />
            <TextBlock x:Name="ModulesText" Foreground="#98989F" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</Window>

